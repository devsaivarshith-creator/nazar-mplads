# ==========================================
# NAZAR Configuration Environment Variables
# ==========================================

# Active AI Provider: "mock" (default, zero-cost), "gemini", or "openai"
AI_PROVIDER=mock

# Google Gemini API Key (Required only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (Required only if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Dataset Mode
NEXT_PUBLIC_DEMO_MODE=true

# Python Engine URL (if running sidecar)
ENGINE_URL=http://localhost:8000
